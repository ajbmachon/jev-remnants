# jvr environment — copy to `.env` and fill in what you need.
# Lookup order: real environment wins, then this file, then ~/.config/jvn/env.
# Identical convention to jvn and comment-tool.

# The TypeSafe Jev endpoint (default):
#TYPESAFE_API_KEY=tsk-...
#TYPESAFE_BASE_URL=https://api.typesafe.ai
#TYPESAFE_DEFAULT_MODEL=jev-latest

# Drex by Nace.AI — the same SDK, different endpoint:
#TYPESAFE_API_KEY=nace-...
#TYPESAFE_BASE_URL=https://drex.nace.ai
#TYPESAFE_DEFAULT_MODEL=drex-latest

# Route tables with automatic failover live in jvn (SYSTEM_ONE_ROUTES, see jvn's .env.example);
# jvr shares the checkout config chain with it, so one .env per checkout is enough.
